{
  "method": {
    "prefix": "method",
    "body": ["method ${1:name}(${2:int value}) : ${3:int} {", "\t$0", "}"],
    "description": "Method declaration"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "}"],
    "description": "if statement"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "}"],
    "description": "if / else"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"],
    "description": "while loop"
  },
  "for": {
    "prefix": "for",
    "body": ["for (var ${1:i} = 0; ${1:i} < ${2:n}; ${1:i} += 1) {", "\t$0", "}"],
    "description": "counting for loop"
  },
  "println": {
    "prefix": "println",
    "body": ["hand:con println(string text)", "", "println(\"${1:Hello world}\")"],
    "description": "Console println declaration and call"
  },
  "array": {
    "prefix": "array",
    "body": "array<${1:int}> ${2:items} = [${3:1, 2, 3}]",
    "description": "array declaration"
  }
}
