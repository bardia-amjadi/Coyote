# Standard.Time: clocks, pauses and date formatting (the "time" permission, granted by default).
hand:time uptimeMs(): long
hand:time unixSeconds(): long
hand:time sleep(int ms)
hand:time format(long unixSeconds, string format, boolean utc): string

public class Time {
    # Milliseconds since the program first asked.
    public shared method UptimeMs(): long { return uptimeMs() }
    # Seconds since 1970-01-01 UTC.
    public shared method UnixSeconds(): long { return unixSeconds() }
    # Pauses for 0 to 60000 milliseconds.
    public shared method Sleep(int ms) { sleep(ms) }
    # Formats a Unix time in the local time zone with strftime codes: Time.Format(Time.UnixSeconds(), "%Y-%m-%d %H:%M:%S").
    public shared method Format(long seconds, string pattern): string { return format(seconds, pattern, false) }
    # The same in UTC.
    public shared method FormatUtc(long seconds, string pattern): string { return format(seconds, pattern, true) }
    # The current local time formatted with strftime codes.
    public shared method Now(string pattern): string { return format(unixSeconds(), pattern, false) }

    # ---- calendar parts (UTC, proleptic Gregorian calendar) ----
    # true for leap years.
    public shared method IsLeapYear(int year): boolean {
        return (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
    }
    # Days in a month (1 to 12) of a year.
    public shared method DaysInMonth(int year, int month): int {
        if (month < 1 || month > 12) { throw new Exception("month must be between 1 and 12") }
        if (month == 2) {
            if (IsLeapYear(year)) { return 29 }
            return 28
        }
        if (month == 4 || month == 6 || month == 9 || month == 11) { return 30 }
        return 31
    }
    # Unix seconds of a UTC date and time; every part is checked (month 1-12, day within the month, hour 0-23, minute and second 0-59).
    public shared method FromParts(int year, int month, int day, int hour, int minute, int second): long {
        if (day < 1 || day > DaysInMonth(year, month)) { throw new Exception("day is outside the month") }
        if (hour < 0 || hour > 23) { throw new Exception("hour must be between 0 and 23") }
        if (minute < 0 || minute > 59) { throw new Exception("minute must be between 0 and 59") }
        if (second < 0 || second > 59) { throw new Exception("second must be between 0 and 59") }
        long y = year
        if (month <= 2) { y = y - 1 }
        long era = FloorDiv(y, 400)
        long yoe = y - era * 400
        long mp = month + 9
        if (month > 2) { mp = month - 3 }
        long doy = (153 * mp + 2) / 5 + day - 1
        long doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
        long days = era * 146097 + doe - 719468
        return days * 86400 + hour * 3600 + minute * 60 + second
    }
    # The year of a Unix time (UTC).
    public shared method Year(long seconds): int { return Civil(seconds, 0) }
    # The month, 1 to 12 (UTC).
    public shared method Month(long seconds): int { return Civil(seconds, 1) }
    # The day of the month, 1 to 31 (UTC).
    public shared method Day(long seconds): int { return Civil(seconds, 2) }
    # The hour, 0 to 23 (UTC).
    public shared method Hour(long seconds): int { return int((seconds - FloorDiv(seconds, 86400) * 86400) / 3600) }
    # The minute, 0 to 59 (UTC).
    public shared method Minute(long seconds): int { return int((seconds - FloorDiv(seconds, 3600) * 3600) / 60) }
    # The second, 0 to 59 (UTC).
    public shared method Second(long seconds): int { return int(seconds - FloorDiv(seconds, 60) * 60) }
    # The day of the week: 0 is Sunday, 6 is Saturday (UTC).
    public shared method DayOfWeek(long seconds): int {
        long days = FloorDiv(seconds, 86400)
        return int((days % 7 + 11) % 7)
    }
    # The day of the year, 1 to 366 (UTC).
    public shared method DayOfYear(long seconds): int {
        int year = Year(seconds)
        long start = FromParts(year, 1, 1, 0, 0, 0)
        return int(FloorDiv(seconds - start, 86400)) + 1
    }
    # Rounds down toward negative infinity.
    public shared method FloorDiv(long a, long b): long {
        long q = a / b
        if (a % b != 0 && (a < 0) != (b < 0)) { q = q - 1 }
        return q
    }
    shared method Civil(long seconds, int which): int {
        long z = FloorDiv(seconds, 86400) + 719468
        long era = FloorDiv(z, 146097)
        long doe = z - era * 146097
        long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
        long y = yoe + era * 400
        long doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
        long mp = (5 * doy + 2) / 153
        long d = doy - (153 * mp + 2) / 5 + 1
        long m = mp - 9
        if (mp < 10) { m = mp + 3 }
        if (m <= 2) { y = y + 1 }
        if (which == 0) { return int(y) }
        if (which == 1) { return int(m) }
        return int(d)
    }
}
