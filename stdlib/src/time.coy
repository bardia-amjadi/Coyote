# Standard library: Time and Random.
hand:time uptimeMs(): int
hand:time unixSeconds(): int
hand:time sleep(int ms)
hand:random seed(int value)
hand:random nextInt(int low, int high): int
hand:random nextDouble(): double

export class Time {
    # Milliseconds since the program first asked (wraps after about 24 days).
    public static method UptimeMs(): int { return uptimeMs() }
    # Seconds since 1970-01-01 UTC.
    public static method UnixSeconds(): int { return unixSeconds() }
    # Pauses for 0 to 60000 milliseconds.
    public static method Sleep(int ms) { sleep(ms) }
}

export class Random {
    public static method Seed(int value) { seed(value) }
    # A random int from low to high, both included.
    public static method NextInt(int low, int high): int { return nextInt(low, high) }
    # A random double from 0.0 (included) up to 1.0.
    public static method NextDouble(): double { return nextDouble() }
}
