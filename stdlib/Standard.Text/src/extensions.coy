# Standard.Text extension methods: every Text function can also be called on the string itself, for example "hi".Upper() or "a,b".Split(",").
# Extension names are plain global names; if one clashes with your own method, call the Text class form (Text.Upper(s)) and rename yours.

# Number of characters.
public method Length(here string s): int { return Text.Length(s) }
# true for "".
public method IsEmpty(here string s): boolean { return Text.IsEmpty(s) }
# true for "" or only spaces, tabs and line breaks.
public method IsBlank(here string s): boolean { return Text.IsBlank(s) }
# count characters from start; a runtime error when start is outside the text.
public method Substring(here string s, int start, int count): string { return Text.Substring(s, start, count) }
# The character at an index.
public method CharAt(here string s, int index): char { return Text.CharAt(s, index) }
# Index of the first occurrence of part, or -1.
public method IndexOf(here string s, string part): int { return Text.IndexOf(s, part) }
# true when part occurs in s.
public method Contains(here string s, string part): boolean { return Text.Contains(s, part) }
public method StartsWith(here string s, string prefix): boolean { return Text.StartsWith(s, prefix) }
public method EndsWith(here string s, string suffix): boolean { return Text.EndsWith(s, suffix) }
# ASCII letters only.
public method Upper(here string s): string { return Text.Upper(s) }
public method Lower(here string s): string { return Text.Lower(s) }
# Removes spaces, tabs and line breaks at both ends.
public method Trim(here string s): string { return Text.Trim(s) }
# Replaces every occurrence of find (not empty) with with.
public method Replace(here string s, string find, string with): string { return Text.Replace(s, find, with) }
# s repeated times times.
public method Repeat(here string s, int times): string { return Text.Repeat(s, times) }
# Pads on the left with pad (one or more characters) until the text is at least width characters.
public method PadLeft(here string s, int width, string pad): string { return Text.PadLeft(s, width, pad) }
public method PadRight(here string s, int width, string pad): string { return Text.PadRight(s, width, pad) }
# The characters in reverse order.
public method Reverse(here string s): string { return Text.Reverse(s) }
# Cuts s at every occurrence of sep (not empty). "a,b,,c" split at "," -> ["a", "b", "", "c"].
public method Split(here string s, string sep): array<string> { return Text.Split(s, sep) }
# The parts joined with sep between them.
public method Join(here array<string> parts, string sep): string { return Text.Join(parts, sep) }
# The text parsed as an int (a runtime error when it is not a number).
public method ToInt(here string s): int { return int(s) }
# The text parsed as a double.
public method ToDouble(here string s): double { return double(s) }
