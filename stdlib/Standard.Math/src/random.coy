# Standard.Math: random numbers (the "random" permission, granted by default).
hand:random seed(int value)
hand:random nextInt(int low, int high): int
hand:random nextDouble(): double

public class Random {
    # Makes the sequence repeatable.
    public shared method Seed(int value) { seed(value) }
    # A random int from low to high, both included.
    public shared method NextInt(int low, int high): int { return nextInt(low, high) }
    # A random double from 0.0 (included) up to 1.0.
    public shared method NextDouble(): double { return nextDouble() }
    # true or false with equal chance.
    public shared method NextBool(): boolean { return nextInt(0, 1) == 1 }
    # One random element of a non-empty array.
    public shared method PickString(array<string> items): string { return items[nextInt(0, items.length - 1)] }
}
