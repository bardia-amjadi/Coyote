# Standard.Math: integer helpers and simple statistics.

public class Numbers {
    # Greatest common divisor (always >= 0).
    public shared method Gcd(int a, int b): int {
        int x = a
        int y = b
        if (x < 0) { x = 0 - x }
        if (y < 0) { y = 0 - y }
        while (y != 0) {
            int t = x % y
            x = y
            y = t
        }
        return x
    }
    # Least common multiple.
    public shared method Lcm(int a, int b): int {
        if (a == 0 || b == 0) { return 0 }
        int g = Gcd(a, b)
        int r = (a / g) * b
        if (r < 0) { r = 0 - r }
        return r
    }
    public shared method IsPrime(int n): boolean {
        if (n < 2) { return false }
        int i = 2
        while (i * i <= n) {
            if (n % i == 0) { return false }
            i = i + 1
        }
        return true
    }
    # n! (a runtime error on overflow, from 13 up).
    public shared method Factorial(int n): int {
        int r = 1
        int i = 2
        while (i <= n) {
            r = r * i
            i = i + 1
        }
        return r
    }
    # The n-th Fibonacci number (0, 1, 1, 2, ...).
    public shared method Fibonacci(int n): int {
        int a = 0
        int b = 1
        int i = 0
        while (i < n) {
            int t = a + b
            a = b
            b = t
            i = i + 1
        }
        return a
    }
    # x clamped between low and high.
    public shared method ClampInt(int x, int low, int high): int {
        if (x < low) { return low }
        if (x > high) { return high }
        return x
    }
    # -1, 0 or 1.
    public shared method Sign(int x): int {
        if (x < 0) { return -1 }
        if (x > 0) { return 1 }
        return 0
    }
    # Converts degrees to radians.
    public shared method ToRadians(double degrees): double { return degrees * 3.141592653589793 / 180.0 }
    # Converts radians to degrees.
    public shared method ToDegrees(double radians): double { return radians * 180.0 / 3.141592653589793 }
}
