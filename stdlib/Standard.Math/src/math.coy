# Standard.Math: numbers and random numbers.
hand:math sqrt(double x): double
hand:math pow(double x, double y): double
hand:math sin(double x): double
hand:math cos(double x): double
hand:math tan(double x): double
hand:math asin(double x): double
hand:math acos(double x): double
hand:math atan(double x): double
hand:math atan2(double y, double x): double
hand:math exp(double x): double
hand:math log(double x): double
hand:math log10(double x): double
hand:math floor(double x): double
hand:math ceil(double x): double
hand:math round(double x): double

public class Math {
    # The ratio of a circle's circumference to its diameter.
    public shared field double PI = 3.141592653589793
    # Euler's number.
    public shared field double E = 2.718281828459045

    public shared method Sqrt(double x): double { return sqrt(x) }
    # x to the power y.
    public shared method Pow(double x, double y): double { return pow(x, y) }
    public shared method Sin(double x): double { return sin(x) }
    public shared method Cos(double x): double { return cos(x) }
    public shared method Tan(double x): double { return tan(x) }
    public shared method Asin(double x): double { return asin(x) }
    public shared method Acos(double x): double { return acos(x) }
    public shared method Atan(double x): double { return atan(x) }
    # The angle of the point (x, y) in radians.
    public shared method Atan2(double y, double x): double { return atan2(y, x) }
    public shared method Exp(double x): double { return exp(x) }
    # Natural logarithm.
    public shared method Log(double x): double { return log(x) }
    public shared method Log10(double x): double { return log10(x) }
    # Rounds down.
    public shared method Floor(double x): double { return floor(x) }
    # Rounds up.
    public shared method Ceil(double x): double { return ceil(x) }
    # Rounds to the nearest whole number (halves away from zero).
    public shared method Round(double x): double { return round(x) }
    public shared method Abs(double x): double {
        if (x < 0.0) { return -x }
        return x
    }
    public shared method AbsInt(int x): int {
        if (x < 0) { return -x }
        return x
    }
    public shared method Min(double a, double b): double {
        if (a < b) { return a }
        return b
    }
    public shared method Max(double a, double b): double {
        if (a > b) { return a }
        return b
    }
    public shared method MinInt(int a, int b): int {
        if (a < b) { return a }
        return b
    }
    public shared method MaxInt(int a, int b): int {
        if (a > b) { return a }
        return b
    }
    # Limits x to the range low..high.
    public shared method Clamp(double x, double low, double high): double {
        if (x < low) { return low }
        if (x > high) { return high }
        return x
    }
}
