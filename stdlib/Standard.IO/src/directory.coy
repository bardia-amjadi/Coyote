# Standard.IO: folders. Needs the "file" permission.
hand:dir exists(string path): boolean
hand:dir create(string path)
hand:dir delete(string path, boolean recursive): boolean
hand:dir list(string path): string
hand:text length(string s): int
hand:text substring(string s, int start, int count): string
hand:text indexOf(string s, string part): int

# Splits text at every "\n"; a trailing line break does not create an empty last line; "\r" is dropped.
method splitLines(string text): array<string> {
    array<string> parts = new array<string>(0)
    int start = 0
    int n = length(text)
    while (start < n) {
        int at = indexOf(substring(text, start, n - start), "\n")
        string line = ""
        if (at < 0) {
            line = substring(text, start, n - start)
            start = n
        } else {
            line = substring(text, start, at)
            start = start + at + 1
        }
        int ln = length(line)
        if (ln > 0 && substring(line, ln - 1, 1) == "\r") { line = substring(line, 0, ln - 1) }
        parts.push(line)
    }
    return parts
}

# Folders.
export class Directory {
    # true when the path is an existing folder.
    public static method Exists(string path): boolean { return exists(path) }
    # Creates the folder and any missing parents.
    public static method Create(string path) { create(path) }
    # Deletes a folder; with recursive = true also everything inside it. false when it did not exist.
    public static method Delete(string path, boolean recursive): boolean { return delete(path, recursive) }
    # The names inside a folder, sorted; folder names end with "/".
    public static method List(string path): array<string> { return splitLines(list(path)) }
}
