# Standard.IO: file names and paths (text only; nothing here touches the disk).
hand:text length(string s): int
hand:text substring(string s, int start, int count): string

method isSep(string c): boolean { return c == "/" || c == "\\" }

# Index just after the last '/' or '\' (0 when there is none).
method afterLastSep(string p): int {
    int i = length(p)
    while (i > 0) {
        if (isSep(substring(p, i - 1, 1))) { return i }
        i = i - 1
    }
    return 0
}

# Index of the last '.' in the file name part, or -1.
method lastDot(string p): int {
    int start = afterLastSep(p)
    int i = length(p)
    while (i > start) {
        if (substring(p, i - 1, 1) == ".") { return i - 1 }
        i = i - 1
    }
    return -1
}

export class Path {
    # Joins two parts with exactly one separator ("/"); an absolute second part replaces the first.
    public static method Combine(string a, string b): string {
        if (length(a) == 0) { return b }
        if (length(b) == 0) { return a }
        if (isSep(substring(b, 0, 1))) { return b }
        if (isSep(substring(a, length(a) - 1, 1))) { return a + b }
        return a + "/" + b
    }
    # The last part: "a/b/c.txt" -> "c.txt".
    public static method FileName(string p): string {
        int i = afterLastSep(p)
        return substring(p, i, length(p) - i)
    }
    # The file name without its extension: "a/c.txt" -> "c".
    public static method FileNameWithoutExtension(string p): string {
        string n = FileName(p)
        int d = lastDot(n)
        if (d <= 0) { return n }
        return substring(n, 0, d)
    }
    # The extension with its dot: "c.txt" -> ".txt"; "" when there is none.
    public static method Extension(string p): string {
        int d = lastDot(p)
        if (d < 0 || d == afterLastSep(p)) { return "" }
        return substring(p, d, length(p) - d)
    }
    # Everything before the last separator: "a/b/c.txt" -> "a/b"; "" when there is none.
    public static method DirectoryName(string p): string {
        int i = afterLastSep(p)
        if (i <= 1) { return "" }
        return substring(p, 0, i - 1)
    }
    # Replaces (or adds) the extension; pass it with its dot, e.g. ".md".
    public static method ChangeExtension(string p, string ext): string {
        int d = lastDot(p)
        if (d <= afterLastSep(p)) { return p + ext }
        return substring(p, 0, d) + ext
    }
}
