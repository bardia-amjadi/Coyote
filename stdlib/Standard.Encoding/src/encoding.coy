# Standard.Encoding: bytes <-> text. A "byte array" is an array<int> whose items are 0..255.
# Code points are counted like Standard.Text counts characters (one item per character).
hand:text length(string s): int
hand:text substring(string s, int start, int count): string
hand:text charAt(string s, int index): char
hand:encoding toBytes(string s): array<byte>
hand:encoding fromBytes(array<byte> data): string

# Text of a list of pieces, joined without O(n*n) copying.
method joinPieces(array<string> pieces): string {
    array<string> level = pieces
    while (level.length > 1) {
        array<string> next = new array<string>(0)
        int i = 0
        while (i < level.length) {
            if (i + 1 < level.length) { next.push(level[i] + level[i + 1]) } else { next.push(level[i]) }
            i = i + 2
        }
        level = next
    }
    if (level.length == 0) { return "" }
    return level[0]
}

public class Encoding {
    # The code points (characters as numbers) of a text.
    public shared method CodePoints(string s): array<int> {
        array<int> r = new array<int>(0)
        int n = length(s)
        int at = 0
        while (at < n) {
            int take = 64
            if (take > n - at) { take = n - at }
            string chunk = substring(s, at, take)
            int k = 0
            while (k < take) {
                r.push(int(charAt(chunk, k)))
                k = k + 1
            }
            at = at + take
        }
        return r
    }
    # The text made of these code points. An item that is not a valid code point becomes U+FFFD.
    public shared method FromCodePoints(array<int> cps): string {
        array<string> pieces = new array<string>(0)
        string cur = ""
        int count = 0
        in (var cp of cps) {
            int c = cp
            if (c < 0 || c > 1114111 || (c >= 55296 && c <= 57343)) { c = 65533 }
            cur = cur + string(char(c))
            count = count + 1
            if (count == 128) { pieces.push(cur); cur = ""; count = 0 }
        }
        pieces.push(cur)
        return joinPieces(pieces)
    }
    # The UTF-8 bytes of a text, as a compact array<byte>.
    public shared method ToBytes(string s): array<byte> { return toBytes(s) }
    # Decodes UTF-8 bytes; a broken sequence becomes U+FFFD.
    public shared method FromBytes(array<byte> data): string { return fromBytes(data) }
    # An array<byte> made from ints 0..255 (the older Utf8/Hex/Base64 classes work with array<int>); an item outside 0..255 stops the program.
    public shared method IntsToBytes(array<int> items): array<byte> {
        array<byte> r = new array<byte>(0)
        in (var v of items) { r.push(byte(v)) }
        return r
    }
    # The items of an array<byte> as ints 0..255.
    public shared method BytesToInts(array<byte> data): array<int> {
        array<int> r = new array<int>(0)
        in (var b of data) { r.push(b) }
        return r
    }
    # 0 .. 255 check shared by the byte helpers.
    public shared method IsByte(int b): boolean { return b >= 0 && b <= 255 }
}

# UTF-8 (the encoding Coyote text uses everywhere).
public class Utf8 {
    public shared method GetBytes(string s): array<int> {
        array<int> out = new array<int>(0)
        in (var c of Encoding.CodePoints(s)) {
            if (c < 128) { out.push(c) }
            else if (c < 2048) { out.push(192 + c / 64); out.push(128 + c % 64) }
            else if (c < 65536) { out.push(224 + c / 4096); out.push(128 + (c / 64) % 64); out.push(128 + c % 64) }
            else { out.push(240 + c / 262144); out.push(128 + (c / 4096) % 64); out.push(128 + (c / 64) % 64); out.push(128 + c % 64) }
        }
        return out
    }
    public shared method ByteCount(string s): int { return GetBytes(s).length }
    # Decodes UTF-8; a broken sequence becomes U+FFFD.
    public shared method GetString(array<int> bytes): string {
        array<int> cps = new array<int>(0)
        int i = 0
        int n = bytes.length
        while (i < n) {
            int b = bytes[i]
            int need = 0
            int cp = 0
            if (b < 128) { cp = b }
            else if (b >= 194 && b < 224) { need = 1; cp = b - 192 }
            else if (b >= 224 && b < 240) { need = 2; cp = b - 224 }
            else if (b >= 240 && b < 245) { need = 3; cp = b - 240 }
            else { cp = 65533 }
            if (need > 0) {
                int j = 1
                boolean ok = i + need < n
                while (ok && j <= need) {
                    int cb = bytes[i + j]
                    if (cb < 128 || cb > 191) { ok = false } else { cp = cp * 64 + (cb - 128) }
                    j = j + 1
                }
                if (ok && ((need == 2 && cp < 2048) || (need == 3 && (cp < 65536 || cp > 1114111)) || (cp >= 55296 && cp <= 57343))) { ok = false }
                if (!ok) { cp = 65533; need = 0 }
            }
            cps.push(cp)
            i = i + 1 + need
        }
        return Encoding.FromCodePoints(cps)
    }
}

# 7-bit ASCII: a character above 127 becomes '?'.
public class Ascii {
    public shared method GetBytes(string s): array<int> {
        array<int> out = new array<int>(0)
        in (var c of Encoding.CodePoints(s)) { if (c < 128) { out.push(c) } else { out.push(63) } }
        return out
    }
    public shared method GetString(array<int> bytes): string {
        array<int> cps = new array<int>(0)
        in (var b of bytes) { if (b >= 0 && b < 128) { cps.push(b) } else { cps.push(63) } }
        return Encoding.FromCodePoints(cps)
    }
}

# Latin-1 (ISO-8859-1): characters up to U+00FF, others become '?'.
public class Latin1 {
    public shared method GetBytes(string s): array<int> {
        array<int> out = new array<int>(0)
        in (var c of Encoding.CodePoints(s)) { if (c < 256) { out.push(c) } else { out.push(63) } }
        return out
    }
    public shared method GetString(array<int> bytes): string {
        array<int> cps = new array<int>(0)
        in (var b of bytes) { if (b >= 0 && b < 256) { cps.push(b) } else { cps.push(63) } }
        return Encoding.FromCodePoints(cps)
    }
}

# UTF-16, little endian, with surrogate pairs.
public class Utf16 {
    public shared method GetBytes(string s): array<int> {
        array<int> out = new array<int>(0)
        in (var c of Encoding.CodePoints(s)) {
            if (c < 65536) { out.push(c % 256); out.push(c / 256) }
            else {
                int v = c - 65536
                int hi = 55296 + v / 1024
                int lo = 56320 + v % 1024
                out.push(hi % 256); out.push(hi / 256); out.push(lo % 256); out.push(lo / 256)
            }
        }
        return out
    }
    public shared method GetString(array<int> bytes): string {
        array<int> cps = new array<int>(0)
        int i = 0
        while (i + 1 < bytes.length) {
            int u = bytes[i] + bytes[i + 1] * 256
            i = i + 2
            if (u >= 55296 && u < 56320 && i + 1 < bytes.length) {
                int lo = bytes[i] + bytes[i + 1] * 256
                if (lo >= 56320 && lo < 57344) {
                    cps.push(65536 + (u - 55296) * 1024 + (lo - 56320))
                    i = i + 2
                } else { cps.push(65533) }
            } else { cps.push(u) }
        }
        return Encoding.FromCodePoints(cps)
    }
}

# Base64 (RFC 4648), with padding. UrlSafe uses - and _ and no padding.
public class Base64 {
    hidden shared locked field string Std = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    hidden shared locked field string Url = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    hidden shared method Enc(array<int> bytes, string alphabet, boolean pad): string {
        array<string> pieces = new array<string>(0)
        string cur = ""
        int i = 0
        int n = bytes.length
        while (i < n) {
            int b0 = bytes[i]
            int b1 = 0
            int b2 = 0
            if (i + 1 < n) { b1 = bytes[i + 1] }
            if (i + 2 < n) { b2 = bytes[i + 2] }
            int v = b0 * 65536 + b1 * 256 + b2
            cur = cur + substring(alphabet, v / 262144, 1) + substring(alphabet, (v / 4096) % 64, 1)
            if (i + 1 < n) { cur = cur + substring(alphabet, (v / 64) % 64, 1) } else if (pad) { cur = cur + "=" }
            if (i + 2 < n) { cur = cur + substring(alphabet, v % 64, 1) } else if (pad) { cur = cur + "=" }
            if (length(cur) > 256) { pieces.push(cur); cur = "" }
            i = i + 3
        }
        pieces.push(cur)
        return joinPieces(pieces)
    }
    hidden shared method Dec(string text, string alphabet): array<int> {
        array<int> out = new array<int>(0)
        int acc = 0
        int bits = 0
        in (var c of Encoding.CodePoints(text)) {
            if (c == 61 || c == 10 || c == 13 || c == 32) { continue }
            int v = -1
            int k = 0
            while (k < 64) { if (int(charAt(alphabet, k)) == c) { v = k; break } k = k + 1 }
            if (v < 0) { throw "Base64: the text contains the invalid character '" + string(char(c)) + "'" }
            acc = acc * 64 + v
            bits = bits + 6
            if (bits >= 8) {
                bits = bits - 8
                int p = 1
                int q = 0
                while (q < bits) { p = p * 2; q = q + 1 }
                out.push(acc / p)
                acc = acc % p
            }
        }
        return out
    }
    public shared method Encode(array<int> bytes): string { return Enc(bytes, Std, true) }
    public shared method Decode(string text): array<int> { return Dec(text, Std) }
    public shared method EncodeUrlSafe(array<int> bytes): string { return Enc(bytes, Url, false) }
    public shared method DecodeUrlSafe(string text): array<int> { return Dec(text, Url) }
    # Base64 of the UTF-8 bytes of a text, and back.
    public shared method EncodeText(string s): string { return Enc(Utf8.GetBytes(s), Std, true) }
    public shared method DecodeText(string text): string { return Utf8.GetString(Dec(text, Std)) }
}

# Hexadecimal (lower case when encoding; both cases when decoding).
public class Hex {
    hidden shared locked field string Digits = "0123456789abcdef"
    public shared method Encode(array<int> bytes): string {
        array<string> pieces = new array<string>(0)
        string cur = ""
        in (var b of bytes) {
            if (b < 0 || b > 255) { throw "Hex: " + b + " is not a byte" }
            cur = cur + substring(Digits, b / 16, 1) + substring(Digits, b % 16, 1)
            if (length(cur) > 256) { pieces.push(cur); cur = "" }
        }
        pieces.push(cur)
        return joinPieces(pieces)
    }
    # The value 0..15 of a hexadecimal digit character code, or -1.
    public shared method Digit(int c): int {
        if (c >= 48 && c <= 57) { return c - 48 }
        if (c >= 97 && c <= 102) { return c - 87 }
        if (c >= 65 && c <= 70) { return c - 55 }
        return -1
    }
    public shared method Decode(string text): array<int> {
        array<int> cps = Encoding.CodePoints(text)
        if (cps.length % 2 != 0) { throw "Hex: the text has an odd number of digits" }
        array<int> out = new array<int>(0)
        int i = 0
        while (i < cps.length) {
            int hi = Digit(cps[i])
            int lo = Digit(cps[i + 1])
            if (hi < 0 || lo < 0) { throw "Hex: invalid hexadecimal digit near position " + i }
            out.push(hi * 16 + lo)
            i = i + 2
        }
        return out
    }
    public shared method EncodeText(string s): string { return Encode(Utf8.GetBytes(s)) }
    public shared method DecodeText(string text): string { return Utf8.GetString(Decode(text)) }
}

# Percent encoding for URLs: letters, digits and - _ . ~ stay, everything else becomes %XX of its UTF-8 bytes.
public class Url {
    public shared method Encode(string s): string {
        array<string> pieces = new array<string>(0)
        string cur = ""
        in (var b of Utf8.GetBytes(s)) {
            boolean keep = (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95 || b == 46 || b == 126
            if (keep) { cur = cur + string(char(b)) } else { cur = cur + "%" + substring("0123456789ABCDEF", b / 16, 1) + substring("0123456789ABCDEF", b % 16, 1) }
            if (length(cur) > 256) { pieces.push(cur); cur = "" }
        }
        pieces.push(cur)
        return joinPieces(pieces)
    }
    # Decodes %XX (and '+' as a space when plusIsSpace).
    public shared method Decode(string s, boolean plusIsSpace): string {
        array<int> cps = Encoding.CodePoints(s)
        array<int> bytes = new array<int>(0)
        int i = 0
        while (i < cps.length) {
            int c = cps[i]
            if (c == 37) {
                if (i + 2 >= cps.length) { throw "Url: a '%' needs two hexadecimal digits" }
                array<int> two = Hex.Decode(string(char(cps[i + 1])) + string(char(cps[i + 2])))
                bytes.push(two[0])
                i = i + 3
            } else if (c == 43 && plusIsSpace) {
                bytes.push(32)
                i = i + 1
            } else {
                in (var b of Utf8.GetBytes(string(char(c)))) { bytes.push(b) }
                i = i + 1
            }
        }
        return Utf8.GetString(bytes)
    }
}

# HTML / XML text escaping.
public class Html {
    public shared method Encode(string s): string {
        array<string> pieces = new array<string>(0)
        in (var c of Encoding.CodePoints(s)) {
            if (c == 38) { pieces.push("&amp;") }
            else if (c == 60) { pieces.push("&lt;") }
            else if (c == 62) { pieces.push("&gt;") }
            else if (c == 34) { pieces.push("&quot;") }
            else if (c == 39) { pieces.push("&#39;") }
            else { pieces.push(string(char(c))) }
        }
        return joinPieces(pieces)
    }
    public shared method Decode(string s): string {
        array<int> cps = Encoding.CodePoints(s)
        array<int> out = new array<int>(0)
        int i = 0
        while (i < cps.length) {
            if (cps[i] == 38) {
                int j = i + 1
                while (j < cps.length && j - i < 10 && cps[j] != 59) { j = j + 1 }
                if (j < cps.length && cps[j] == 59) {
                    string name = Encoding.FromCodePoints(Slice(cps, i + 1, j))
                    int v = Entity(name)
                    if (v >= 0) { out.push(v); i = j + 1; continue }
                }
            }
            out.push(cps[i])
            i = i + 1
        }
        return Encoding.FromCodePoints(out)
    }
    hidden shared method Slice(array<int> a, int from, int to): array<int> {
        array<int> r = new array<int>(0)
        int i = from
        while (i < to) { r.push(a[i]); i = i + 1 }
        return r
    }
    hidden shared method Entity(string name): int {
        if (name == "amp") { return 38 }
        if (name == "lt") { return 60 }
        if (name == "gt") { return 62 }
        if (name == "quot") { return 34 }
        if (name == "apos") { return 39 }
        if (name == "nbsp") { return 160 }
        array<int> cps = Encoding.CodePoints(name)
        if (cps.length >= 2 && cps[0] == 35) {
            int v = 0
            int i = 1
            int radix = 10
            if (cps[1] == 120 || cps[1] == 88) { radix = 16; i = 2 }
            if (i >= cps.length) { return -1 }
            while (i < cps.length) {
                int d = Hex.Digit(cps[i])
                if (d < 0 || d >= radix) { return -1 }
                v = v * radix + d
                i = i + 1
            }
            if (v > 1114111) { return -1 }
            return v
        }
        return -1
    }
}
