{
  "name": "coyote-studio",
  "productName": "Coyote Studio",
  "version": "0.6.1",
  "description": "Coyote Studio: editor, build, run and debug environment for the Coyote language",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-packager . CoyoteStudio --platform=win32 --arch=x64 --out=dist --overwrite --asar --ignore=\"^/dist\" --ignore=\"^/test\" --ignore=\"^/node_modules/monaco-editor/(dev|esm)\" --ignore=\"^/node_modules/monaco-editor/min-maps\" --ignore=\"^/node_modules/(@electron|@malept|@sindresorhus|@szmarczak|@types|@xmldom|electron)(/|$)\" --ignore=\"\\.map$\""
  },
  "dependencies": {
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "@electron/packager": "18.3.6"
  }
}
